# ── etchmem-server configuration ──────────────────────────────────────────
# Copy to .env and fill in. All values have sane defaults except API keys.

# ── LLM cascade (Pydantic AI model strings; swap freely) ───────────────────
# Stage 2 — claim extraction (cheap/mini model).
ETCHMEM_CLAIM_MODEL=openai:gpt-5-mini
# Stage 3 — conflict resolution + narrative (most capable model).
ETCHMEM_ETCH_MODEL=openai:gpt-5.5
OPENAI_API_KEY=sk-...

# ── Embeddings (pluggable) ─────────────────────────────────────────────────
# "openai" (default) or "local" (sentence-transformers, offline) or "fake" (tests)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Storage ────────────────────────────────────────────────────────────────
# Directory holding left.duckdb (signals+claims) and right.duckdb (entities+etches).
ETCHMEM_DATA_DIR=/data

# ── Extensions ──────────────────────────────────────────────────────────────
# Folder of YAML files declaring extra properties to extract (e.g. sales_intent).
# Additive vocabulary; never overrides the core (entity, property, value) triple.
ETCHMEM_EXT_DIR=./ext

# ── Stage 1: signal dedup ──────────────────────────────────────────────────
# Cosine distance below which two raw signals are collapsed (provenance kept).
ETCHMEM_SIGNAL_DEDUP_DISTANCE=0.08
# Max separation in EVENT TIME for two signals to be considered duplicates at
# all. 0 = off (time ignored). Set it when ingesting a historical archive:
# formulaic records years apart embed almost identically, and collapsing them
# merges unrelated histories. 7 days = 604800.
ETCHMEM_DEDUP_MAX_TIME_GAP_SECONDS=0

# ── Entity resolution ──────────────────────────────────────────────────────
# Cosine similarity above which two entity names are treated as the same entity.
# This is a FALLBACK. When your subjects are identifiers (article numbers, SKUs,
# part numbers), do not tune this — declare an `entities:` block with an
# `identifier_pattern` in ext/ instead, so identity is string equality and
# MSM-0808 can never be merged into MSM-0809. See ext/catalogue-support.yaml.
ETCHMEM_ENTITY_SIM_THRESHOLD=0.86

# ── Consolidation / fold ───────────────────────────────────────────────────
# Properties allowed to hold multiple values at once (union, never a conflict).
ETCHMEM_MULTI_VALUE_PROPERTIES=tech_stack,integrations
# Optional per-source trust weights (JSON). A gap >= TRUST_GAP resolves conflicts.
ETCHMEM_SOURCE_TRUST_JSON={}
ETCHMEM_TRUST_GAP=0.3

# ── Event time ─────────────────────────────────────────────────────────────
# Which wins when a signal declares `occurred_at` AND the extractor reads a date
# out of the text:
#   extracted (default) - the in-text date wins; it is more specific (a 2014
#       record may state something became true in 2009).
#   declared            - the caller's occurred_at always wins. Use for bulk
#       backfills where the record date is authoritative and a misread date
#       would corrupt the timeline silently.
ETCHMEM_OCCURRED_AT_PRECEDENCE=extracted

# ── Privacy: claims anonymization ──────────────────────────────────────────
# true = anonymize personal data when signals are folded into claims/etches:
# person/company names become consistent numbered tokens ([PERSON_1],
# [COMPANY_2]); addresses, bank cards, IBANs, emails, phones become generic
# tokens ([ADDRESS], [BANK_CARD], ...). Recall then returns etches only —
# raw signals (which keep original text for provenance) are never surfaced.
ETCHMEM_CLAIMS_ANONYMIZATION=false

# ── Worker (in-process; no external broker) ────────────────────────────────
ETCHMEM_WORKER_ENABLED=true
ETCHMEM_WORKER_INTERVAL_SECONDS=5
ETCHMEM_EXTRACT_MIN_BATCH=1
ETCHMEM_EXTRACT_MAX_WAIT_SECONDS=30

# ── Signal TTL ─────────────────────────────────────────────────────────────
ETCHMEM_SIGNAL_TTL_SECONDS=0

# ── Server ─────────────────────────────────────────────────────────────────
ETCHMEM_HOST=0.0.0.0
ETCHMEM_PORT=8000

# ── Stage-2 extraction throughput ───────────────────────────────────────────
# Signals combined into ONE extraction LLM call.
ETCHMEM_EXTRACT_LLM_BATCH_SIZE=6
# Extraction LLM calls in flight at once (raise carefully — 429 risk).
ETCHMEM_EXTRACT_CONCURRENCY=4
# Retries with exponential backoff on 429 / transient LLM errors.
ETCHMEM_LLM_MAX_RETRIES=4
